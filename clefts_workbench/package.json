{
  "name": "clefts-workbench",
  "displayName": "CLEFTS Workbench",
  "description": "Run and inspect CLEFTS applications from VS Code.",
  "version": "0.5.0",
  "publisher": "clefts",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": [
    "onCommand:clefts.openWorkbench",
    "onCommand:clefts.openResult",
    "onCustomEditor:clefts.resultViewer",
    "onCustomEditor:clefts.cleavagePatternSetEditor"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      { "command": "clefts.openWorkbench", "title": "CLEFTS: Open Workbench" },
      { "command": "clefts.openResult", "title": "CLEFTS: Open Result" }
    ],
    "customEditors": [
      {
        "viewType": "clefts.resultViewer",
        "displayName": "CLEFTS Result",
        "selector": [{ "filenamePattern": "*.pft" }, { "filenamePattern": "*.clefts-result" }],
        "priority": "default"
      },
      {
        "viewType": "clefts.cleavagePatternSetEditor",
        "displayName": "CLEFTS Cleavage Pattern Set",
        "selector": [{ "filenamePattern": "*.clevageset.json" }],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "CLEFTS",
      "properties": {
        "clefts.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used for CLEFTS CLI commands."
        },
        "clefts.applicationRoot": {
          "type": "string",
          "default": "",
          "description": "Workspace-relative CLEFTS Python project directory. Empty enables automatic parent and mnt/app discovery."
        }
      }
    }
  },
  "scripts": {
    "dev": "code --extensionDevelopmentPath=. --new-window .",
    "check": "node --check src/extension.js && node --check src/features/smarts-search/editor.js && node --check src/features/cleavage-pattern-set/editor.js && node scripts/check-result-webview.js && node scripts/check-score-distribution.js && node scripts/check-smarts-compound-view.js && node scripts/check-finetune.js && node scripts/check-step-validation.js && node scripts/check-training-metrics.js",
    "package": "mkdir -p artifacts && npx @vscode/vsce package --allow-missing-repository --out artifacts/clefts_workbench-${npm_package_version}.vsix"
  },
  "devDependencies": { "@vscode/vsce": "2.15.0" },
  "overrides": { "cheerio": "1.0.0-rc.12" },
  "license": "MIT"
}
